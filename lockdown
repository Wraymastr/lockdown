    $btnClose.Add_Click({ $dlg.Close() })

    $btnAdd.Add_Click({
        $tokens = @($script:blTbAdd.Text -split '[,;\s]+' | Where-Object { $_ })
        if ($tokens.Count -eq 0) { return }

        $current = @(Get-Blocklist)
        $added   = @()
        $invalid = @()
        $dupes   = @()
        foreach ($t in $tokens) {
            $c = ConvertTo-CleanHostname $t
            if (-not $c)                                           { $invalid += $t }
            elseif (($current -contains $c) -or ($added -contains $c)) { $dupes += $c }
            else                                                   { $added += $c }
        }

        if ($invalid.Count -gt 0) {
            [System.Windows.Forms.MessageBox]::Show(
                "Not a valid domain name, skipped:`n`n" + ($invalid -join "`n"),
                "Invalid Entry", "OK", "Warning") | Out-Null
        }

        if ($added.Count -gt 0) {
            $newList = @(($current + $added) | Sort-Object -Unique)
            try {
                Save-Blocklist $newList
                Update-LiveBlocklist $newList
                Write-UILog "Blocklist: added $($added -join ', ')" "OK"
                $script:blTbAdd.Clear()
            } catch {
                Write-UILog "Blocklist update failed: $_" "ERROR"
                [System.Windows.Forms.MessageBox]::Show(
                    "Could not update the hosts file:`n$_",
                    "Error", "OK", "Error") | Out-Null
            }
            $script:blList.Items.Clear()
            foreach ($d in @(Get-Blocklist)) { [void]$script:blList.Items.Add($d) }
            Update-UI
        } elseif ($dupes.Count -gt 0) {
            Write-UILog "Already blocked: $($dupes -join ', ')" "WARN"
            $script:blTbAdd.Clear()
        }
    })

    $btnRemove.Add_Click({
        $selected = @($script:blList.SelectedItems | ForEach-Object { [string]$_ })
        if ($selected.Count -eq 0) { return }

        $current = @(Get-Blocklist)
        $newList = @($current | Where-Object { $selected -notcontains $_ })
        try {
            Save-Blocklist $newList
            Update-LiveBlocklist $newList
            Write-UILog "Blocklist: removed $($selected -join ', ')" "OK"
        } catch {
            Write-UILog "Blocklist update failed: $_" "ERROR"
            [System.Windows.Forms.MessageBox]::Show(
                "Could not update the hosts file:`n$_",
                "Error", "OK", "Error") | Out-Null
        }
        $script:blList.Items.Clear()
        foreach ($d in @(Get-Blocklist)) { [void]$script:blList.Items.Add($d) }
        Update-UI
    })

    $dlg.ShowDialog($form) | Out-Null
}

# ---------------------------------------------------------------
# UPDATE-UI  — refreshes all state-driven controls
# ---------------------------------------------------------------
$script:IsLocked      = $false
$script:SelectedMode  = "Whitelist"   # what the selector shows while unlocked
$script:EffectiveMode = "Whitelist"   # active mode if locked, else selected mode

function Set-ModeButtonStyle {
    param([System.Windows.Forms.Button]$Btn, [bool]$Selected)
    if ($Selected) {
        $Btn.BackColor = $clrAccentCfg
        $Btn.ForeColor = [System.Drawing.Color]::White
        $Btn.FlatAppearance.BorderColor = $clrAccentCfg
    } else {
        $Btn.BackColor = $clrPanel
        $Btn.ForeColor = $clrTextMuted
        $Btn.FlatAppearance.BorderColor = $clrBorder
    }
}

function Update-UI {
    $script:IsLocked      = Test-LockdownFlag
    $script:EffectiveMode = if ($script:IsLocked) { Get-LockdownMode } else { $script:SelectedMode }
    $isBL    = ($script:EffectiveMode -eq "Blocklist")
    $blCount = @(Get-Blocklist).Count

    # --- Mode selector ---
    Set-ModeButtonStyle $btnModeWL (-not $isBL)
    Set-ModeButtonStyle $btnModeBL $isBL
    $btnModeWL.Enabled = (-not $script:IsLocked)
    $btnModeBL.Enabled = (-not $script:IsLocked)

    # --- Configuration panel (mode-specific) ---
    if ($isBL) {
        $lblCfgCap.Text = "BLOCKLIST CONFIGURATION"
        $cfgRow1.Cap.Text = "BLOCKED DOMAINS"
        $cfgRow1.Val.Text = "$blCount domain(s)  (+ www. variants)"
        $cfgRow2.Cap.Text = "METHOD"
        $cfgRow2.Val.Text = "Hosts file  (0.0.0.0 and ::)"
        $btnConfig.Text   = "MANAGE BLOCKLIST"
    } else {
        $lblCfgCap.Text = "ACTIVE CONFIGURATION"
        $cfgRow1.Cap.Text = "WHITELIST DOMAIN"
        $cfgRow1.Val.Text = $CONFIG.WhitelistDomain
        $cfgRow2.Cap.Text = "BLACK-HOLE PROXY"
        $cfgRow2.Val.Text = $CONFIG.BlackHoleProxy
        $btnConfig.Text   = "EDIT CONFIGURATION"
    }
    $cfgRow3.Val.Text = "$($CONFIG.DeadManHours)h via Dead Man's Switch"

    # --- Status + action button ---
    if ($script:IsLocked) {
        if ($isBL) {
            $lblStatusValue.Text      = "BLOCKING"
            $lblStatusValue.ForeColor = $clrAmber
            $lblStatusSub.Text        = "Blocklist active — $blCount domain(s) blocked, everything else open."
            $script:dotColor          = $clrAmber
        } else {
            $lblStatusValue.Text      = "LOCKED"
            $lblStatusValue.ForeColor = $clrRed
            $lblStatusSub.Text        = "Internet restricted — only whitelisted domain passes."
            $script:dotColor          = $clrRed
        }
        $btnAction.Text      = "RESTORE SYSTEM"
        $btnAction.BackColor = $clrAccentRest
        $pnlDMS.Visible      = $true
        $btnConfig.Enabled   = $true   # whitelist edits apply next cycle; blocklist edits apply live

        $dmsTime = Get-DeadMansSwitchTime
        if ($dmsTime) {
            $lblDMSText.Text = "  Dead Man's Switch active — auto-restore scheduled at $dmsTime"
        }
    } else {
        $lblStatusValue.Text      = "NORMAL"
        $lblStatusValue.ForeColor = $clrGreen
        $lblStatusSub.Text        = "All internet traffic is unrestricted."
        $script:dotColor          = $clrGreen
        if ($isBL) {
            $btnAction.Text      = "ACTIVATE BLOCKLIST"
            $btnAction.BackColor = $clrAccentBlock
        } else {
            $btnAction.Text      = "ACTIVATE LOCKDOWN"
            $btnAction.BackColor = $clrAccentLock
        }
        $pnlDMS.Visible    = $false
        $btnConfig.Enabled = $true
    }

    $picDot.Invalidate()
    $form.Refresh()
}

# ---------------------------------------------------------------
# BUTTON EVENT HANDLERS
# ---------------------------------------------------------------
$btnModeWL.Add_Click({
    $script:SelectedMode = "Whitelist"
    Update-UI
})

$btnModeBL.Add_Click({
    $script:SelectedMode = "Blocklist"
    Update-UI
})

$btnConfig.Add_Click({
    if ($script:EffectiveMode -eq "Blocklist") { Show-BlocklistDialog } else { Show-ConfigDialog }
})

$btnAction.Add_Click({
    $btnAction.Enabled  = $false
    $btnConfig.Enabled  = $false
    $btnAction.Text     = "WORKING..."

    if (-not $script:IsLocked) {
        if ($script:SelectedMode -eq "Blocklist") {
            # ---------- START BLOCKLIST MODE ----------
            $blCount = @(Get-Blocklist).Count
            if ($blCount -eq 0) {
                Write-UILog "Blocklist is empty — add domains first." "WARN"
                [System.Windows.Forms.MessageBox]::Show(
                    "The blocklist is empty. Click MANAGE BLOCKLIST and add at least one domain first.",
                    "Nothing to Block", "OK", "Information") | Out-Null
            } else {
                Write-UILog "Activating blocklist mode..." "INFO"
                $ok = Invoke-BlocklistStart
                if ($ok) {
                    Write-UILog "Blocklist ACTIVE — $blCount domain(s) blocked via hosts file" "OK"
                    Write-UILog "Dead Man's Switch fires in $($CONFIG.DeadManHours)h" "OK"
                } else {
                    Write-UILog "Blocklist activation FAILED — see log file for details." "ERROR"
                    [System.Windows.Forms.MessageBox]::Show(
                        "Could not activate blocklist mode. Check the activity log.",
                        "Error", "OK", "Error") | Out-Null
                }
            }
        } else {
            # ---------- START WHITELIST LOCKDOWN ----------
            Write-UILog "Initiating lockdown..." "INFO"
            $ok = Invoke-Lockdown
            if ($ok) {
                Write-UILog "Lockdown ACTIVE — proxy: $($CONFIG.BlackHoleProxy)" "OK"
                Write-UILog "Whitelist: $($CONFIG.WhitelistDomain) + subdomains" "OK"
                Write-UILog "Dead Man's Switch fires in $($CONFIG.DeadManHours)h" "OK"
            } else {
                Write-UILog "Lockdown FAILED — see log file for details." "ERROR"
                [System.Windows.Forms.MessageBox]::Show(
                    "Lockdown failed. Check the activity log.",
                    "Error", "OK", "Error") | Out-Null
            }
        }
    } else {
        $confirm = [System.Windows.Forms.MessageBox]::Show(
            "Restore system to normal operation?",
            "Confirm Restore", "YesNo", "Question")
        if ($confirm -eq "Yes") {
            Write-UILog "Initiating restore..." "INFO"
            $ok = Invoke-Restore
            if ($ok) {
                Write-UILog "System RESTORED — all restrictions removed." "OK"
            } else {
                Write-UILog "Restore had errors — check: $LogFile" "ERROR"
            }
        } else {
            Write-UILog "Restore cancelled by user." "WARN"
        }
    }

    $btnAction.Enabled = $true
    $btnConfig.Enabled = $true
    Update-UI
})

# ---------------------------------------------------------------
# STARTUP
# ---------------------------------------------------------------
Update-UI

Write-UILog "Exam Lockdown Tool v2.2 started."
Write-UILog "Host: $($env:COMPUTERNAME)  •  User: $($env:USERNAME)"

if ($script:IsLocked) {
    Write-UILog "Existing $($script:EffectiveMode) session detected — system is currently LOCKED." "WARN"
} else {
    if ($CONFIG.WhitelistDomain -eq "INSERT_DOMAIN_HERE" -or [string]::IsNullOrWhiteSpace($CONFIG.WhitelistDomain)) {
        Write-UILog "No whitelist domain configured — click EDIT CONFIGURATION to set one." "WARN"
    }
    Write-UILog "System is NORMAL. Pick a mode and activate."
}

[System.Windows.Forms.Application]::Run($form)
